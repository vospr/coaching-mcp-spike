{
  "name": "coaching-mcp-spike",
  "version": "0.1.0",
  "description": "One-day spike: MCP server exposing a coaching product's low-risk capabilities to Copilot / ChatGPT Enterprise / Claude Desktop (anonymized, stub backend)",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "dev:stdio": "tsx src/stdio.ts",
    "dev:http": "tsx src/http.ts",
    "inspect": "npx @modelcontextprotocol/inspector node dist/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
